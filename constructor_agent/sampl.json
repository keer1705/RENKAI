  {
    "project": "pdf",
    "algorithm_steps": [
      {
        "step_number": 1,
        "step_title": "Foundation Setup and Configuration",
        "step_description": "Initialize base environment, imports, and configuration management",
        "pseudocode": [
          "IMPORT os, sys, logging, json",
          "DEFINE class Configuration:",
          "    METHOD __init__(self, config_path=None, defaults=None, env_overrides=None):",
          "        SET self.config_path = config_path",
          "        SET self.defaults = defaults or {}",
          "        SET self.env_overrides = env_overrides or {}",
          "        SET self.config = {}",
          "        CALL self.load()",
          "    METHOD load(self):",
          "        IF self.config_path THEN",
          "            SET file_cfg = CALL self.load_from_file(self.config_path)",
          "        ELSE",
          "            SET file_cfg = {}",
          "        SET env_cfg = CALL self.load_from_env()",
          "        SET self.config = CALL self.merge_dicts(self.defaults, file_cfg, env_cfg, self.env_overrides)",
          "    METHOD load_from_file(self, path):",
          "        WITH open(path, 'r') AS f:",
          "            RETURN json.load(f)",
          "    METHOD load_from_env(self):",
          "        SET env_cfg = {}",
          "        FOR each key, value IN os.environ.items():",
          "            IF key.startswith('PDF_AGENT_') THEN",
          "                SET env_cfg[key[10:]] = value",
          "        RETURN env_cfg",
          "    METHOD merge_dicts(self, *dicts):",
          "        SET result = {}",
          "        FOR each d IN dicts:",
          "            FOR each k, v IN d.items():",
          "                SET result[k] = v",
          "        RETURN result",
          "CALL logger = logging.getLogger('PDFAgent')",
          "CALL logger.setLevel(logging.INFO)",
          "DEFINE class BaseAgent:",
          "    METHOD __init__(self, config, logger, state=None):",
          "        SET self.config = config",
          "        SET self.logger = logger",
          "        SET self.state = state or {}"
        ],
        "inputs": [
          "config_file_path (optional)",
          "environment_variables"
        ],
        "outputs": [
          "Configuration",
          "BaseAgent",
          "logger",
          "final_config"
        ],
        "dependencies": {
          "requires_previous_steps": [],
          "provides_for_next_steps": [
            "Configuration",
            "BaseAgent",
            "logger"
          ]
        }
      },
      {
        "step_number": 2,
        "step_title": "Data Structures",
        "step_description": "Define data models and state management",
        "pseudocode": [
          "IMPORT dataclasses.dataclass, typing.List, typing.Dict, typing.Optional, field",
          "@dataclass",
          "DEFINE class PDFPage:",
          "    page_number: int",
          "    text: str",
          "    metadata: Optional[Dict[str, str]] = None",
          "@dataclass",
          "DEFINE class PDFDocument:",
          "    doc_id: str",
          "    title: Optional[str] = None",
          "    author: Optional[str] = None",
          "    pages: List[PDFPage] = field(default_factory=list)",
          "    metadata: Optional[Dict[str, str]] = None",
          "DEFINE class AgentState:",
          "    METHOD __init__(self):",
          "        SET self.documents = {}  # key: doc_id, value: PDFDocument",
          "        SET self.cache = {}  # generic cache for intermediate results",
          "    METHOD add_document(self, doc):",
          "        SET self.documents[doc.doc_id] = doc",
          "    METHOD get_document(self, doc_id):",
          "        RETURN self.documents.get(doc_id)"
        ],
        "inputs": [
          "BaseAgent"
        ],
        "outputs": [
          "PDFPage",
          "PDFDocument",
          "AgentState"
        ],
        "dependencies": {
          "requires_previous_steps": [
            1
          ],
          "provides_for_next_steps": [
            "PDFPage",
            "PDFDocument",
            "AgentState"
          ]
        }
      },
      {
        "step_number": 3,
        "step_title": "Core Algorithm",
        "step_description": "Define core processing logic with abstract service methods",
        "pseudocode": [
          "IMPORT abc.ABC, abc.abstractmethod, typing.List, typing.Dict",
          "DEFINE class PDFProcessor(BaseAgent, ABC):",
          "    METHOD __init__(self, config, logger, state):",
          "        CALL super().__init__(config, logger, state)",
          "        SET self.llm_service = None  # to be injected",
          "        SET self.pdf_service = None  # to be injected",
          "    METHOD set_services(self, llm_service, pdf_service):",
          "        SET self.llm_service = llm_service",
          "        SET self.pdf_service = pdf_service",
          "    METHOD ingest_pdf(self, file_path):",
          "        CALL self.logger.info(f\"Ingesting PDF: {file_path}\")",
          "        SET raw_pages = CALL self.pdf_service.extract_pages(file_path)",
          "        SET doc_id = CALL self.generate_doc_id(file_path)",
          "        SET pdf_doc = CALL self.build_pdf_document(doc_id, raw_pages)",
          "        CALL self.state.add_document(pdf_doc)",
          "        RETURN doc_id",
          "    METHOD build_pdf_document(self, doc_id, raw_pages):",
          "        SET pages = []",
          "        FOR idx, page_text IN enumerate(raw_pages, start=1):",
          "            SET page = PDFPage(page_number=idx, text=page_text)",
          "            CALL pages.append(page)",
          "        SET pdf_doc = PDFDocument(doc_id=doc_id, pages=pages)",
          "        RETURN pdf_doc",
          "    METHOD summarize(self, doc_id, max_length=200):",
          "        SET doc = CALL self.state.get_document(doc_id)",
          "        IF doc IS None THEN",
          "            CALL self.logger.error(\"Document not found\")",
          "            RETURN \"\"",
          "        SET full_text = CALL self.concatenate_text(doc.pages)",
          "        SET prompt = f\"Summarize the following text in {max_length} words:\\n{full_text}\"",
          "        SET summary = CALL self.llm_service.generate_text(prompt)",
          "        RETURN summary",
          "    METHOD answer_question(self, doc_id, question):",
          "        SET doc = CALL self.state.get_document(doc_id)",
          "        IF doc IS None THEN",
          "            CALL self.logger.error(\"Document not found\")",
          "            RETURN \"\"",
          "        SET context = CALL self.concatenate_text(doc.pages)",
          "        SET prompt = f\"Context:\\n{context}\\n\\nQuestion: {question}\\nAnswer:\"",
          "        SET answer = CALL self.llm_service.generate_text(prompt)",
          "        RETURN answer",
          "    METHOD create_pdf(self, content, metadata):",
          "        CALL self.logger.info(\"Generating PDF from content\")",
          "        SET pdf_bytes = CALL self.pdf_service.create_pdf(content, metadata)",
          "        RETURN pdf_bytes",
          "    METHOD modify_pdf(self, doc_id, modifications):",
          "        SET doc = CALL self.state.get_document(doc_id)",
          "        IF doc IS None THEN",
          "            CALL self.logger.error(\"Document not found\")",
          "            RETURN b\"\"",
          "        SET modified_bytes = CALL self.pdf_service.apply_modifications(doc, modifications)",
          "        RETURN modified_bytes",
          "    METHOD extract_metadata(self, doc_id):",
          "        SET doc = CALL self.state.get_document(doc_id)",
          "        IF doc IS None THEN",
          "            CALL self.logger.error(\"Document not found\")",
          "            RETURN {}",
          "        RETURN doc.metadata or {}",
          "    METHOD concatenate_text(self, pages):",
          "        SET texts = [page.text for page in pages]",
          "        RETURN \" \".join(texts)",
          "    ABSTRACT METHOD generate_doc_id(self, source):",
          "        PASS"
        ]
      },
      {
        "step_number": 4,
        "step_title": "External Services",
        "step_description": "Implement concrete services for LLM and PDF handling",
        "pseudocode": [
          "IMPORT hashlib, io",
          "DEFINE class SimpleLLMService:",
          "    METHOD __init__(self, api_key=None, model_name=\"gpt-3.5-turbo\"):",
          "        SET self.api_key = api_key",
          "        SET self.model_name = model_name",
          "    METHOD generate_text(self, prompt):",
          "        CALL self.log_prompt(prompt)",
          "        RETURN f\"Generated response for prompt: {prompt[:50]}...\"",
          "    METHOD log_prompt(self, prompt):",
          "        PASS",
          "DEFINE class PDFLibService:",
          "    METHOD __init__(self):",
          "        PASS",
          "    METHOD extract_pages(self, file_path):",
          "        RETURN [\"Page 1 text\", \"Page 2 text\"]",
          "    METHOD create_pdf(self, content, metadata):",
          "        SET buffer = io.BytesIO()",
          "        CALL buffer.write(content.encode('utf-8'))",
          "        RETURN buffer.getvalue()",
          "    METHOD apply_modifications(self, pdf_doc, modifications):",
          "        FOR page IN pdf_doc.pages:",
          "            SET page.text = page.text + \"\\n\" + modifications.get('note', '')",
          "        RETURN CALL self.create_pdf(self.concatenate_pages(pdf_doc.pages), pdf_doc.metadata or {})",
          "    METHOD concatenate_pages(self, pages):",
          "        RETURN \"\\n---\\n\".join([p.text for p in pages])"
        ]
      },
      {
        "step_number": 5,
        "step_title": "Integration and Agent Assembly",
        "step_description": "Compose concrete processor, inject services, and expose high-level agent API",
        "pseudocode": [
          "IMPORT hashlib, uuid",
          "DEFINE class ConcretePDFProcessor(PDFProcessor):",
          "    METHOD __init__(self, config, logger, state):",
          "        CALL super().__init__(config, logger, state)",
          "    METHOD generate_doc_id(self, source):",
          "        SET hash_input = f\"{source}-{uuid.uuid4()}\"",
          "        RETURN hashlib.sha256(hash_input.encode('utf-8')).hexdigest()",
          "DEFINE class PDFAgent(BaseAgent):",
          "    METHOD __init__(self, config_path=None):",
          "        SET config = CALL Configuration(config_path)",
          "        SET logger = logging.getLogger('PDFAgent')",
          "        CALL logger.setLevel(logging.INFO)",
          "        SET state = CALL AgentState()",
          "        CALL super().__init__(config, logger, state)",
          "        SET self.processor = CALL ConcretePDFProcessor(config, logger, state)",
          "        SET self.llm_service = CALL SimpleLLMService(api_key=config.config.get('llm_api_key'))",
          "        SET self.pdf_service = CALL PDFLibService()",
          "        CALL self.processor.set_services(self.llm_service, self.pdf_service)",
          "    METHOD ingest_and_process(self, file_path):",
          "        SET doc_id = CALL self.processor.ingest_pdf(file_path)",
          "        RETURN doc_id",
          "    METHOD get_summary(self, doc_id):",
          "        RETURN CALL self.processor.summarize(doc_id)",
          "    METHOD ask(self, doc_id, question):",
          "        RETURN CALL self.processor.answer_question(doc_id, question)",
          "    METHOD generate_new_pdf(self, content, metadata):",
          "        RETURN CALL self.processor.create_pdf(content, metadata)"
        ]
      },
      {
        "step_number": 6,
        "step_title": "Usage Example",
        "step_description": "Demonstrate initialization and typical workflow of the PDF agent",
        "pseudocode": [
          "IMPORT os",
          "DEFINE class Demo:",
          "    METHOD run(self):",
          "        SET config_path = os.getenv('PDF_AGENT_CONFIG', 'config.json')",
          "        SET agent = CALL PDFAgent(config_path)",
          "        SET sample_pdf = \"sample.pdf\"",
          "        CALL agent.logger.info(\"Starting ingestion\")",
          "        SET doc_id = CALL agent.ingest_and_process(sample_pdf)",
          "        CALL agent.logger.info(f\"Ingested doc_id: {doc_id}\")",
          "        SET summary = CALL agent.get_summary(doc_id)",
          "        CALL agent.logger.info(f\"Summary: {summary}\")",
          "        SET question = \"What is the main conclusion?\"",
          "        SET answer = CALL agent.ask(doc_id, question)",
          "        CALL agent.logger.info(f\"Q&A Answer: {answer}\")",
          "        SET new_content = \"This is a generated report based on the summary.\"",
          "        SET new_pdf_bytes = CALL agent.generate_new_pdf(new_content, {\"title\": \"Generated Report\"})",
          "        CALL agent.logger.info(f\"Generated PDF size: {len(new_pdf_bytes)} bytes\")"
        ]
      }
    ]
  }

